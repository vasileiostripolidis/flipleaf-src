{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flipleaf",
  "version": "1.1.0",
  "identifier": "io.github.vasileiostripolidis.flipleaf",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Flipleaf",
        "width": 1100,
        "height": 820,
        "minWidth": 420,
        "minHeight": 320,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A feather-light PDF reader",
    "longDescription": "Flipleaf is a feather-light, private PDF reader for Windows, macOS and Linux.",
    "publisher": "Vasileios Tripolidis",
    "copyright": "© 2026 Vasileios Tripolidis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "name": "PDF Document",
        "description": "PDF document",
        "role": "Viewer"
      }
    ]
  }
}