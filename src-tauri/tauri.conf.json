{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flipleaf",
  "version": "1.17.2",
  "identifier": "io.github.vasileiostripolidis.flipleaf",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node .github/scripts/protect.mjs --dev",
    "beforeBuildCommand": "node .github/scripts/protect.mjs --desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Flipleaf",
        "width": 1240,
        "height": 860,
        "minWidth": 560,
        "minHeight": 360,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "A feather-light, private PDF reader and editor",
    "longDescription": "Flipleaf is a feather-light, private PDF reader and editor for Windows, macOS and Linux: read, annotate, fill & sign, edit text and images, print and save.",
    "publisher": "Vasileios Tripolidis",
    "copyright": "© 2026 Vasileios Tripolidis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "name": "PDF Document",
        "description": "PDF document",
        "role": "Viewer"
      }
    ],
    "homepage": "https://github.com/vasileiostripolidis/flipleaf",
    "license": "Proprietary",
    "licenseFile": "installer/EULA.rtf",
    "resources": {
      "../legal/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../legal/EULA.md": "EULA.txt",
      "../LICENSE": "LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "uninstallerHeaderImage": "installer/nsis-header.bmp",
        "languages": [
          "English",
          "Greek"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "customLanguageFiles": {
          "Greek": "installer/languages/Greek.nsh"
        }
      }
    },
    "macOS": {
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 200
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEMTcyMTdGOTBGMjY1N0UKUldSK1pmS1FmeUVYN2RsOXM5OVNBOWovSjdvd2NzVTV6YzVGQ1RDT0M2YTkxVTJGR3NSb3FubWUK",
      "endpoints": [
        "https://vasileiostripolidis.github.io/flipleaf/updates/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
